{
  "name": "scadawatt-website",
  "version": "132.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --env-file-if-exists=.env scripts/dev-cms.mjs",
    "build": "node scripts/preserve-static-assets.mjs && node scripts/retire-demo.mjs && node scripts/cms-catalog.mjs && node scripts/build-seo.mjs && tsc --noEmit && vite build && node scripts/compress-web.mjs",
    "preview": "node --use-system-ca --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "test:models": "node scripts/check-model-assets.mjs && vitest run src/test/optimized-scene.test.ts src/test/additional-models.test.ts src/test/model-cache.test.ts",
    "report": "node scripts/analyze-transfer.mjs",
    "start": "node --use-system-ca --env-file-if-exists=.env server/index.mjs",
    "cms:setup": "node --env-file-if-exists=.env server/setup.mjs",
    "cms:reset-password": "node --env-file-if-exists=.env server/setup.mjs --reset",
    "cms:backup": "node --env-file-if-exists=.env server/backup.mjs",
    "test:cms": "node --import ./server/postgres-test-env.mjs --test --test-concurrency=1 server/cms.test.mjs server/contact.test.mjs server/google-reviews.test.mjs server/seo.test.mjs server/postgres.test.mjs server/origin.test.mjs server/mail-diagnostic.test.mjs server/delivery.test.mjs server/mail-persistence.test.mjs",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "prestart": "node scripts/retire-demo.mjs && node --env-file-if-exists=.env scripts/start-local-postgres.mjs",
    "predev": "node scripts/retire-demo.mjs",
    "cms:postgres:setup": "node --env-file-if-exists=.env server/configure-postgres.mjs",
    "cms:migrate-postgres": "node --env-file-if-exists=.env server/migrate-postgres.mjs",
    "test:postgres": "node --import ./server/postgres-test-env.mjs --test server/postgres.test.mjs",
    "cms:reset-2fa": "node --env-file-if-exists=.env server/reset-2fa.mjs",
    "test:security": "node --import ./server/postgres-test-env.mjs --test --test-concurrency=1 server/security.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^14.2.0",
    "nodemailer": "^10.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.180.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.25.76",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^20.0.3",
    "typescript": "^5.8.3",
    "vite": "7.2.2",
    "vitest": "^4.1.10",
    "@electric-sql/pglite": "^0.5.11"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
